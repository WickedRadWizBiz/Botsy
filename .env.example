# Copy to .env and fill in. Never commit .env.

# --- Anthropic (text: research summaries, listings) ---
ANTHROPIC_API_KEY=

# --- Google Gemini image model, Nano Banana 2.1 (coloring pages, stickers) ---
# Gemini API route:
GOOGLE_API_KEY=
# Vertex AI route (only if settings.yaml models.image.api = vertex):
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Recraft API (optional; disabled in settings.yaml until a paid plan is chosen) ---
RECRAFT_API_TOKEN=

# --- Etsy Open API v3 (own shop only, drafts only) ---
ETSY_API_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=http://localhost:3003/callback
ETSY_SHOP_ID=
# OAuth tokens are written here by the publisher's auth step (gitignored)
ETSY_TOKEN_FILE=.etsy_tokens.json
