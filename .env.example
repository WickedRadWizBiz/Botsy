# Copy to .env and fill in. Never commit .env (or .env.*; both are gitignored).
# Labels: [local] only on your machine, [secret] also a GitHub Actions repo secret for
# live weekly runs, [auth] only needed by `python -m publisher auth`.

# --- Anthropic (text: listings) ---
# [local][secret]
ANTHROPIC_API_KEY=

# --- Google Gemini image model, Nano Banana 2.1 (coloring pages, stickers) ---
# Gemini API route (settings.yaml models.image.api = gemini; the only route CI supports):
# [local][secret]
GOOGLE_API_KEY=
# Vertex AI route (only if models.image.api = vertex; local only, CI has no Google
# credentials step). Needs Application Default Credentials: `gcloud auth
# application-default login`, or a service-account key file in GOOGLE_APPLICATION_CREDENTIALS.
# [local]
GOOGLE_CLOUD_PROJECT=
# Blank = settings.yaml imaging.vertex_location (global).
GOOGLE_CLOUD_LOCATION=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Recraft API (optional; disabled in settings.yaml until a paid plan is chosen) ---
# [local]
RECRAFT_API_TOKEN=

# --- Etsy Open API v3 (own shop only, drafts only) ---
# [local][secret]
ETSY_API_KEYSTRING=
ETSY_SHARED_SECRET=
# [auth] Must exactly match a callback URL registered on your Etsy app. Etsy requires https;
# `python -m publisher auth` needs --cert/--key to listen on it, or --paste to paste the redirected URL.
ETSY_REDIRECT_URI=https://localhost:3003/callback
# [local][secret] Numeric shop id; `python -m publisher auth` prints it.
ETSY_SHOP_ID=
# [local] OAuth tokens are written here by `python -m publisher auth` (gitignored).
ETSY_TOKEN_FILE=.etsy_tokens.json
# [secret] CI only: refresh_token from .etsy_tokens.json after `python -m publisher auth`.
# Expires 90 days after issue and may rotate on use; see README "Etsy drafts from GitHub Actions".
ETSY_REFRESH_TOKEN=
# [optional] YYYY-MM-DD the refresh token above was issued, so the publisher warns at 80 days.
# In CI it is the repo variable of the same name (the weekly job updates it on rotation).
# The token file records it by itself (refresh_issued).
# ETSY_REFRESH_TOKEN_ISSUED=

# --- Discord messages from the server (optional; docs/SERVER.md section 11) ---
# [local] Webhook link of the Discord channel the server posts to (drafts, reviews,
# problems, the daily log, the weekly search list). Treat it like a password.
# To get it: Discord channel > Edit Channel > Integrations > Webhooks > New Webhook >
# Copy Webhook URL. Paste it after the = (no quotes), then test on the server with:
#   botsy service notify-test        (or: python -m service notify-test)
# Empty = no Discord messages.
DISCORD_WEBHOOK_URL=

# --- Second shop (optional; see the multi-shop note at the end of settings.yaml) ---
# Each Etsy shop belongs to its own Etsy user, so it needs its own token file. Keep
# "etsy_tokens" in the file name so .gitignore covers it.
# ETSY_SHOP_ID_SECOND=
# ETSY_TOKEN_FILE_SECOND=.etsy_tokens_second.json
# ETSY_REFRESH_TOKEN_SECOND=

# --- Optional overrides ---
# [local] Run date for reproducible output names (YYYY-MM-DD).
# PIPELINE_DATE=2026-10-15
# [local] Where rembg keeps its sticker background model (~170 MB); default ~/.rembg.
# REMBG_HOME=
