# One Botsy check: take in new exports, research, make items, create Etsy drafts
# (dry run until service.live is true in config/settings.yaml), write outbox/status.txt.
# Started by botsy-inbox.path. Secrets come from /opt/botsy/.env, read by the program.
[Unit]
Description=Botsy: process new research exports
After=network-online.target
Wants=network-online.target
# If runs keep finding a file they cannot take in (for example after a settings mistake),
# stop after 20 starts in 10 minutes instead of looping. The daily check still runs;
# setup.sh (or a reboot) switches the watcher back on.
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=oneshot
User=botsy
Group=botsy
WorkingDirectory=/opt/botsy
ExecStart=/opt/botsy/.venv/bin/python -m service tick
Environment=PYTHONUNBUFFERED=1
# Files the service writes are readable by group botsy (the upload account reads the outbox).
UMask=0027
Nice=10
# A full run with image generation can take a while; stop one that hangs.
TimeoutStartSec=4h
# Hardening: no privilege gain, /usr /boot /etc read-only, no access to /home, a private
# /tmp and /dev, no kernel or clock changes, network only over IP (Etsy and the APIs).
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/opt/botsy -/srv/botsy-inbox/incoming -/srv/botsy-inbox/outbox
