# Writes the daily log (outbox/daily-log.txt: what happened in the last 24 hours) and
# posts it to Discord when DISCORD_WEBHOOK_URL is set in /opt/botsy/.env. The Windows
# helper copies the log to Documents\Botsy. It only reads Botsy's records, so it does not
# wait for a check that is running.
[Unit]
Description=Botsy: write the daily log and post it to Discord
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=botsy
Group=botsy
WorkingDirectory=/opt/botsy
ExecStart=/opt/botsy/.venv/bin/python -m service digest
Environment=PYTHONUNBUFFERED=1
UMask=0027
TimeoutStartSec=15min
# Hardening: no privilege gain, /usr /boot /etc read-only, no access to /home, a private
# /tmp and /dev, no kernel or clock changes, network only over IP (Discord).
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/opt/botsy -/srv/botsy-inbox/outbox
