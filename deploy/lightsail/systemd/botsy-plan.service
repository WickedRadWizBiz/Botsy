# The weekly plan: this week's facts (data/plans/<week>/facts.json), Botsy's own draft plan
# (plan.json, which becomes the week's plan order), the signed plan_due event for Hermes, and
# the plan message in Discord. It only reads Botsy's records (it never takes the main lock),
# so it never waits for a check that is running and the plan posts on time. No paid calls.
# Started by botsy-plan.timer every Sunday at 20:00 New York time.
[Unit]
Description=Botsy: prepare the weekly plan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=botsy
Group=botsy
WorkingDirectory=/opt/botsy
ExecStart=/opt/botsy/.venv/bin/python -m service plan prepare
Environment=PYTHONUNBUFFERED=1
UMask=0027
TimeoutStartSec=15min
# Not restarted: a second run would only find the plan already prepared (or too late).
# Hardening: no privilege gain, /usr /boot /etc read-only, no access to /home, a private
# /tmp and /dev, no kernel or clock changes, network only over IP (Discord, and Hermes on
# 127.0.0.1 when plan.hermes_events_url is set).
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/opt/botsy -/srv/botsy-inbox/outbox
