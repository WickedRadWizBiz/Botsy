# Every day at 07:07 New York time (America/New_York: EDT in summer, EST in winter), just
# after Discord's quiet hours end (notify.quiet_hours, 22:00 to 07:00 in schedule.timezone).
# systemd 235+ reads the zone name in OnCalendar (Ubuntu 24.04 has 255).
# Check: systemd-analyze calendar "*-*-* 07:07:00 America/New_York"
# Persistent=true: a run missed while the server was off happens at the next boot.
[Unit]
Description=Botsy: daily log at 07:07 New York time

[Timer]
OnCalendar=*-*-* 07:07:00 America/New_York
Persistent=true
Unit=botsy-digest.service

[Install]
WantedBy=timers.target
