#!/usr/bin/python3 -IS
"""botsy-hermes-resolve: refresh the addresses the hermes user may reach (install_hermes.sh --firewall).

Run as root by botsy-hermes-firewall.service and every 10 minutes by botsy-hermes-resolve.timer.
Looks up a FIXED list of host names (nothing from any config or from Hermes) and refreshes them in
the nftables sets allow_v4 / allow_v6 of table inet botsy_hermes (deploy/hermes/nftables-hermes.conf)
for one hour. Addresses not seen for an hour expire. If no name resolves (DNS down), nothing changes.
"""
import ipaddress
import socket
import subprocess
import sys

HOSTS = ("discord.com", "gateway.discord.gg", "cdn.discordapp.com", "media.discordapp.net",
         "api.anthropic.com")
TABLE = "inet botsy_hermes"
NFT = "/usr/sbin/nft"


def resolve(hosts=HOSTS, lookup=socket.getaddrinfo) -> tuple[set, set]:
    v4, v6 = set(), set()
    for host in hosts:
        try:
            infos = lookup(host, 443, proto=socket.IPPROTO_TCP)
        except OSError:
            continue
        for family, _type, _proto, _name, addr in infos:
            try:
                ip = ipaddress.ip_address(addr[0])
            except ValueError:
                continue
            if ip.is_loopback or ip.is_private or ip.is_link_local or ip.is_multicast or ip.is_unspecified:
                continue                         # never open a hole to local networks
            (v4 if ip.version == 4 else v6).add(str(ip))
    return v4, v6


def script(v4: set, v6: set) -> str:
    lines = []
    for name, ips in (("allow_v4", v4), ("allow_v6", v6)):
        for ip in sorted(ips):
            # destroy + add: refreshes the one-hour timeout of an address that is already there
            lines.append(f"destroy element {TABLE} {name} {{ {ip} }}")
            lines.append(f"add element {TABLE} {name} {{ {ip} timeout 1h }}")
    return "\n".join(lines) + "\n"


def main() -> int:
    v4, v6 = resolve()
    if not v4 and not v6:
        print("botsy-hermes-resolve: no address resolved; the sets were left as they are", file=sys.stderr)
        return 0
    r = subprocess.run([NFT, "-f", "-"], input=script(v4, v6), text=True, capture_output=True)
    if r.returncode != 0:
        print(f"botsy-hermes-resolve: nft failed ({r.returncode}): {r.stderr.strip()[:300]}", file=sys.stderr)
        return 1
    print(f"botsy-hermes-resolve: {len(v4)} IPv4 and {len(v6)} IPv6 addresses refreshed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
