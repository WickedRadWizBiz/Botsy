# Botsy's locked Hermes Agent settings (docs/OVERSEER.md "Lock-down: three layers" and
# "Hermes setup"). Written for the pinned Hermes Agent v0.21.7 (deploy/hermes/hermes-pin.env,
# config schema 50). Every key name was read in that version's own code
# (hermes_cli/config_defaults.py, hermes_cli/tools_config.py, hermes_cli/managed_scope.py,
# tools/mcp_tool_server_run.py, plugins/platforms/discord/adapter.py, gateway/config_loader.py,
# toolsets.py, tools/vision_tools.py, tools/image_source.py, tools/website_policy.py,
# tools/cronjob_tools.py, cron/scheduler.py, tools/kanban_tools.py, tools/discord_tool.py,
# tools/write_approval.py, gateway/slash_access.py), and check_lock.py --probe asks the installed
# Hermes itself what this file turns on.
#
# Decided 2026-10-21 ("too cautious; I want Hermes pulling its weight"): Hermes now also gets
# vision (our own product images only), its own scheduled check-ins, past-chat search, a to-do
# list, a task board, skills (each change waits for your approval) and the non-admin Discord
# tool. Still off: terminal, files, code, browser, computer use, image/video/speech generation,
# sub-agents, Hermes's own web search, Discord administration and any other MCP server.
#
# install_hermes.sh renders this file twice, root-owned, with the same content:
#   /etc/hermes/config.yaml           Hermes's "managed scope": it wins, key by key, over the
#                                     hermes user's own config, its .env and its environment.
#   /home/hermes/.hermes/config.yaml  the hermes user's config, read-only to it.
# check_lock.py refuses a copy that differs from this template, a toolset outside the list for its
# place, an extra MCP server, sampling or elicitation on, memory or skill approval off, an empty
# allowlist, a file the hermes user can write, or a version other than the pin. Do not edit the
# rendered files by hand: edit this template, then run  sudo bash install_hermes.sh  again.
#
# Placeholders (filled from /etc/hermes/hermes.env by check_lock.py render; a rendered file that
# still has one is refused):
#   __DISCORD_ALLOWED_USER_ID__   your Discord user ID (the only person Hermes answers)
# With install_hermes.sh --bridge sudo, the two "command:" and "args:" lines of mcp_servers are
# rendered as  /usr/bin/sudo -n -u botsy /usr/local/bin/botsy-control-read  (and -act) instead.

_config_version: 50
timezone: America/New_York

# ------------------------------------------------------------------ model and money
# Hermes's own Anthropic key (ANTHROPIC_API_KEY in /etc/hermes/hermes.env) belongs to a SEPARATE
# Anthropic workspace with a $10 monthly spend limit (raised from $5 on 2026-10-21), set in the
# Anthropic Console. That limit is the real money guard. No fallback providers, so a failed call
# never moves to another paid provider.
#
# Haiku 5.5 runs every chat and every routine job. Sonnet 5.5 runs only in the scheduled jobs you
# pin to it yourself: v0.21.7 has no per-task model routing inside a chat, and its cronjob tool
# cannot set a model ("models don't pick models", tools/cronjob_tools.py), so a job Hermes makes
# always runs on cron.model below. You create the two Sonnet jobs once, from the server
# (deploy/hermes/README.md "Sonnet jobs"):
#   botsy-weekly-plan        Sunday, the weekly plan
#   botsy-creative-director  Wednesday, creative-director review of briefs and our own previews
# check_lock.py jobs (hourly) refuses Sonnet on any other job and either job scheduled more than
# once a week. Hermes may still "run now" either job when you ask; the $10 limit caps that.
model:
  provider: anthropic
  default: claude-haiku-5-5
fallback_providers: []

# Haiku 5.5 charges 5x for prompts over 100,000 tokens, and cache reads count toward that, so the
# chat history is compressed at about 60,000 tokens.
compression:
  enabled: true
  threshold_tokens: 60000

# Background extras that each cost a model call. Off: the post-turn "self-improvement" fork
# (background_review) and the curator. In v0.21.7 a skill change the fork stages is not named in
# the summary it posts (agent/background_review.py _action_lines), and the curator archives skills
# without the approval gate, so neither meets "every change is posted to you". Skills still
# improve in the chat itself: each change Hermes proposes waits for your /skills approve.
auxiliary:
  background_review:
    enabled: false
  title_generation:
    enabled: false
    model_upgrade_enabled: false
curator:
  enabled: false

# ------------------------------------------------------------------ tools
# Each place Hermes runs the model gets exactly its list below (an allowlist: any toolset or MCP
# server not named stays off). Discord chat gets the most; scheduled jobs get no Discord, task
# board or job tools (Hermes's own scheduler also denies cronjob there, so a job never makes jobs).
toolsets: [botsy-read, botsy-act, memory, vision, cronjob, session_search, todo, kanban, skills, discord]
platform_toolsets:
  discord: [botsy-read, botsy-act, memory, vision, cronjob, session_search, todo, kanban, skills, discord]
  cron: [botsy-read, botsy-act, memory, vision, session_search, todo, skills]
  cli: [botsy-read, botsy-act, memory, vision, session_search, todo, skills]
  webhook: [botsy-read, botsy-act, memory]
  api_server: [botsy-read, botsy-act, memory]

agent:
  # How images reach the model: "native" attaches them to Haiku itself (no extra call). Images
  # come from botsy-read's review_preview tool (our own previews, re-encoded by Botsy, returned as
  # MCP image content) and from what you attach in Discord.
  image_input_mode: native
  # Applied LAST, after every list above, by Hermes's own resolver: these stay off whatever any
  # other setting, adapter, scheduled job or update says. Everything that touches the machine, the
  # open web, other agents, Discord administration or paid media. Only single toolsets are listed:
  # a bundle such as "safe" or "coding" here would also strip vision, skills and todo.
  disabled_toolsets:
    - terminal
    - file
    - web
    - search
    - browser
    - delegation
    - code_execution
    - discord_admin
    - computer_use
    - video
    - image_gen
    - video_gen
    - tts
    - x_search
    - connections
    - catalog
    - project
    - desktop_ui
    - start_chat
    - setup
    - bot_room
    - context_engine
    - yuanbao
    - feishu_doc
    - feishu_drive

# Vision: vision_analyze reads a data: URL, an http(s) URL or a file path (tools/image_source.py).
#  - The web: every host with a dot is on the blocklist below, which vision checks BEFORE any
#    download; the firewall (required) also lets the hermes user reach only Anthropic and Discord.
#  - Files: systemd hides Botsy's folders and /var, /srv, /mnt, /media from Hermes
#    (hermes-gateway.service), so the only images it can open are the ones botsy-read handed it
#    (cached under ~/.hermes/cache) and what you attach in Discord.
# Same pixels at most 3 times per chat (each embed is re-sent with every later message).
vision:
  max_calls_per_image: 3
security:
  allow_lazy_installs: false
  allow_private_urls: false
  redact_secrets: true
  website_blocklist:
    enabled: true
    domains: ["*.*"]
    shared_files: []

# The two Botsy tool servers. botsy-control-connect links Hermes's stdio to Botsy's socket in
# /run/botsy-control/; systemd starts botsy-control there as the botsy user, so the hermes user
# needs no sudo. No environment is passed, no resources or prompts are offered, and the servers
# may never ask Hermes's model for anything (sampling) or ask you through Hermes (elicitation).
mcp_servers:
  botsy-read:
    command: /usr/local/bin/botsy-control-connect
    args: ["read"]
    env: {}
    enabled: true
    timeout: 120
    connect_timeout: 60
    supports_parallel_tool_calls: false
    trust: full
    tools:
      resources: false
      prompts: false
    sampling:
      enabled: false
    elicitation:
      enabled: false
  botsy-act:
    command: /usr/local/bin/botsy-control-connect
    args: ["act"]
    env: {}
    enabled: true
    timeout: 120
    connect_timeout: 60
    supports_parallel_tool_calls: false
    # Decided 2026-10-21: no codes. "untrusted" makes Hermes itself hold every Botsy action
    # (orders, approvals, pause, cap changes) until you click Allow on its approval prompt in
    # Discord; only your allowlisted user ID can click, and a scheduled job is always declined.
    # This check does not depend on what the model decides. Read tools stay "full" (no click).
    trust: untrusted
    tools:
      resources: false
      prompts: false
    sampling:
      enabled: false
    elicitation:
      enabled: false

# ------------------------------------------------------------------ memory and skills
# Hermes's own memory (about 3,600 characters) saves only after you approve each write in chat.
# Skills: Hermes may write and improve its own skills, but every new or changed skill is only
# staged (~/.hermes/pending/skills/) until you look at it and approve it in Discord:
#   /skills pending   /skills diff <id>   /skills approve <id>   /skills reject <id>
# No outside skill folders, no project skills, no shell snippets inside skills, and each skill
# Hermes writes is security-scanned first.
memory:
  memory_enabled: true
  user_profile_enabled: true
  write_approval: true
  provider: ""
skills:
  write_approval: true
  external_dirs: []
  project_discovery: false
  trusted_project_dirs: []
  auto_load: []
  inline_shell: false
  guard_agent_created: true

# ------------------------------------------------------------------ scheduled jobs
# Hermes may create its own check-ins with its cronjob tool. They run on Haiku (cron.model; the
# tool cannot pick a model), get the "cron" toolsets above, and every Botsy action in them is
# declined (approvals.cron_mode: deny), so a job can read and report but never approve.
# allow_agent_scheduling stays off: a running job may not make more jobs.
# v0.21.7 has no job-count or interval setting, so check_lock.py jobs (hourly) enforces them
# and stops Hermes if one is broken: at most 10 jobs, none more often than hourly, no scripts,
# no URL monitors, no other model, provider or work folder, only the cron toolsets.
cron:
  allow_agent_scheduling: false
  catch_up_missed: false
  provider: ""
  model: claude-haiku-5-5
  model_provider: anthropic
  max_parallel_jobs: 1

# Task board (kanban): Hermes keeps its own to-do cards. No worker agents: the dispatcher that
# would start other Hermes processes for cards is off and may claim no profile, and the Triage
# auto-decomposer (an extra model call) is off.
kanban:
  dispatch_in_gateway: false
  dispatch_profiles: []
  review_dispatch: false
  auto_decompose: false
  max_in_progress: 1

approvals:
  mode: manual
  cron_mode: deny
  single_query_mode: deny
  unattended_mode: deny
  destructive_slash_confirm: true
  mcp_reload_confirm: true

# ------------------------------------------------------------------ Discord
# Only your user ID, never a role. Hermes answers only when mentioned in a server channel (DMs
# from you work). Decided 2026-10-21: no codes, so there is no #botsy-codes channel to ignore;
# what you approve through Hermes is posted at once by Botsy to the main channel instead.
discord:
  allow_from: ["__DISCORD_ALLOWED_USER_ID__"]
  allow_all_users: false
  allowed_roles: ""
  ignored_channels: []
  require_mention: true
  # Slash commands. Without an admin list Hermes lets every allowed user run every slash command,
  # including /model (a pricier model for the session), /yolo and /tools (checked in v0.21.7
  # gateway/slash_access.py). "0" is no Discord account, so nobody is an admin (which also keeps
  # "/goal gate add", a shell command, refused) and you keep only the commands listed below, plus
  # /help and /whoami. Hermes gates these per user, and you are the only allowed user:
  #   /memory and /skills  approve or reject Hermes's pending memory and skill writes
  #   /bg /loop /goal      a background chat, a repeating prompt, a standing goal (all on Haiku)
  # /cron is not a Discord command in v0.21.7 (command-line only); ask Hermes in chat instead.
  allow_admin_from: ["0"]
  group_allow_admin_from: ["0"]
  user_allowed_commands: [new, retry, status, stop, compress, memory, skills, bg, loop, goal]
  group_user_allowed_commands: [new, retry, status, stop, compress, memory, skills, bg, loop, goal]
  history_backfill: false
  missed_message_backfill:
    enabled: false
  # The status reactions Hermes adds to your messages while it works.
  reactions: true
  # The non-admin Discord tool: read recent messages and start threads. Member search is left
  # out (other people's details). Pins, deleting messages and roles are discord_admin in v0.21.7
  # and stay off.
  server_actions: [fetch_messages, create_thread]
gateway:
  allow_all_users: false
  unauthorized_dm_behavior: ignore

# ------------------------------------------------------------------ no add-ons, no self-updates
plugins:
  enabled: []
  auto_apply: false
  auto_update_check_hours: 0
hooks: {}
hooks_auto_accept: false
quick_commands: {}
updates:
  check: false
telemetry:
  shared_metrics:
    enabled: false
    send: false
