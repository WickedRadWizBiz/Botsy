# The Hermes Agent release Botsy's server runs (docs/OVERSEER.md "Hermes setup").
# Read (never sourced) by install_hermes.sh and check_lock.py: KEY=value lines only, no quotes,
# no spaces.
#
# Rule (docs/OVERSEER.md "Lock-down", Version): the newest release that is at least 7 days old
# with no hotfix after it. Checked 2026-10-21 on https://github.com/NousResearch/hermes-agent/releases
# and with `git ls-remote --tags`:
#   v0.22.4  tag seen 2026-10-21 (after the first check), too new
#   v0.22.3  2026-10-21  too new
#   v0.22.2  2026-10-15  hotfix, 6 days old
#   v0.22.1  2026-10-14  "built from the wrong commit" (v0.22.2 notes)
#   v0.22.0  2026-10-14  7 days old, but v0.22.1 and the hotfix v0.22.2 followed within two days
#   v0.21.7  2026-10-12  9 days old, no hotfix after it  <- pinned
# Change the pin only on purpose: edit these lines, run install_hermes.sh again (it rebuilds
# /opt/hermes and reruns check_lock.py), then rerun the lock tests.
HERMES_VERSION=0.21.7
HERMES_TAG=v0.21.7
HERMES_COMMIT=71d34bad1045610252eda02ee79549436896e784
HERMES_PUBLISHED=2026-10-12
HERMES_RELEASE_URL=https://github.com/NousResearch/hermes-agent/releases/tag/v0.21.7
HERMES_REPO=https://github.com/NousResearch/hermes-agent.git
HERMES_CONFIG_VERSION=50
HERMES_EXTRAS=anthropic,discord,mcp,web
# Node.js for building the dashboard web UI once at install time (as an unprivileged user; the
# hermes user never runs npm). Pinned Hermes needs node ^22.22.0 || ^24.11.0 || >=26 (package.json
# engines). v22.23.3 (LTS "Jod", 2026-09-23); sha256 from https://nodejs.org/dist/v22.23.3/SHASUMS256.txt,
# read 2026-10-22.
NODE_VERSION=22.23.3
NODE_SHA256_LINUX_X64=df450af89261115ef9f9e3830c3eeb2cc9213b63c720b1af623cb5dcbe2e02de
NODE_SHA256_LINUX_ARM64=a44aeb94849a299b22df10b9e622ec2f605c2183501bc40590705131de7c740f
