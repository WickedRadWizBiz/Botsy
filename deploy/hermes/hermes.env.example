# /etc/hermes/hermes.env: Hermes's two secrets and your Discord user ID (deploy/hermes/README.md).
# root:hermes, mode 0640: only root and the Hermes service read it; Botsy cannot.
# install_hermes.sh creates it from deploy/hermes/hermes.env.example. Fill it in with
#     sudo nano /etc/hermes/hermes.env
# then run  sudo bash /usr/local/lib/botsy/src/deploy/hermes/install_hermes.sh  again.
# Only these three keys are allowed; check_lock.py refuses any other (for example
# GATEWAY_ALLOW_ALL_USERS or HERMES_MANAGED_DIR). KEY=value, no spaces around "=".

# A key from a SEPARATE Anthropic workspace (for example "hermes") with a $5 monthly spend limit,
# never Botsy's own key. Starts with sk-ant-.
ANTHROPIC_API_KEY=

# The Hermes bot's token (Discord Developer Portal > your app > Bot > Reset Token).
DISCORD_BOT_TOKEN=

# Your own Discord user ID, 17-20 digits (Discord settings > Advanced > Developer Mode, then
# right-click your name > Copy User ID). Hermes answers only this person; never a role.
DISCORD_ALLOWED_USER_ID=
