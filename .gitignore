# Secrets
.env
.env.*
!.env.example
# Etsy OAuth tokens: the default file, per-shop files (name each shop's ETSY_TOKEN_FILE_*
# so it contains "etsy_tokens") and the temp file TokenStore writes before renaming.
.etsy_tokens.json
*etsy_tokens*
*_tokens*.json
*.tmp
# TLS key/cert for the `python -m publisher auth --cert/--key` localhost listener
*.pem

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Licensed research exports stay local (do not redistribute)
data/research_inputs/*
!data/research_inputs/.gitkeep

# Generated outputs go to workflow artifacts, not git
output/*
!output/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Server working state (docs/SERVER.md): research history, rejected uploads, lock,
# spending ledger, event journal and the service's memories between ticks
data/history/
data/inbox_rejected/
data/.service.lock
data/research_inputs/.ingested.json
data/spend/
data/events.jsonl
data/events-*.jsonl
data/.service_state.json
# Pack counters and assignments (docs/PACKS.md section 3): they point at design sets under
# output/sets/, which are never committed either
data/packs_state.json
data/.packs_state.json.*.tmp

# Server-only settings overrides (docs/SERVER.md section 14)
config/settings.local.yaml

# KDP briefs and patterns are built from BookBeam exports; never commit them (docs/KDP_RESEARCH.md)
data/briefs/kdp/
